# Paste into Dokploy → the Ghost compose app → Environment, with real values.
# No quotes around values, no spaces around "=". Save, then Redeploy.

# Where readers see the blog. Ghost also listens on this path (/blog).
GHOST_HOST=agentsdr.ai/blog

# Generate each with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
GHOST_DB_PASSWORD=

# Ghost's own email (staff invites, password resets). Resend over SMTP:
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=resend
# A Resend API key, sending access, on a domain verified in Resend.
MAIL_PASSWORD=
MAIL_FROM=AgentSDR <blog@agentsdr.ai>
