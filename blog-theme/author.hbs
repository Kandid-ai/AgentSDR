{{!< default}}

{{#author}}
    <header class="hero sky hero--short">
        <div class="hero__inner">
            {{#if profile_image}}
                <img class="hero__avatar rise" src="{{img_url profile_image size="s"}}" alt="{{name}}">
            {{/if}}
            <p class="eyebrow eyebrow--dark rise">Author</p>
            <h1 class="hero__title skytext rise" style="--rise-delay:120ms">{{name}}</h1>
            {{#if bio}}<p class="hero__lede rise" style="--rise-delay:200ms">{{bio}}</p>{{/if}}
            <p class="hero__count rise" style="--rise-delay:260ms">{{plural ../pagination.total empty="No posts" singular="% post" plural="% posts"}}</p>
        </div>
    </header>
{{/author}}

<section class="archive">
    <div class="archive__inner">
        {{> "sidebar"}}

        <div class="archive__main">
            <div class="card-grid">
                {{#foreach posts}}{{> "post-card"}}{{/foreach}}
            </div>

            {{> "pagination"}}
        </div>
    </div>
</section>

{{> "cta"}}
