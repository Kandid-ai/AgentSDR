{{!< default}}

<header class="hero sky">
    <div class="hero__inner">
        <p class="eyebrow eyebrow--dark rise">Blog</p>
        <h1 class="hero__title skytext rise" style="--rise-delay:120ms">
            {{#if pagination.prev}}The AgentSDR blog, page {{pagination.page}}{{else}}The AgentSDR blog{{/if}}
        </h1>
        <p class="hero__lede rise" style="--rise-delay:200ms">Playbooks, product updates and field notes on running outbound across email, LinkedIn and WhatsApp, from the open-source AI SDR.</p>
    </div>
</header>

{{!-- The lead story only exists on page one; deeper pages are a plain grid. --}}
{{#unless pagination.prev}}
    {{#foreach posts limit="1"}}{{> "hero-post"}}{{/foreach}}
{{/unless}}

<section class="archive">
    <div class="archive__inner">
        {{> "sidebar"}}

        <div class="archive__main">
            <div class="card-grid">
                {{#unless pagination.prev}}
                    {{!-- from="2" skips the post already shown as the lead. --}}
                    {{#foreach posts from="2"}}{{> "post-card"}}{{/foreach}}
                {{else}}
                    {{#foreach posts}}{{> "post-card"}}{{/foreach}}
                {{/unless}}
            </div>

            {{> "pagination"}}
        </div>
    </div>
</section>

{{> "cta"}}
