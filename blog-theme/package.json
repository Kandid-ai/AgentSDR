{
  "name": "agentsdr",
  "description": "The AgentSDR blog theme: a Ghost theme in the look of agentsdr.ai",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "AGPL-3.0",
  "author": {
    "name": "AgentSDR",
    "email": "hello@agentsdr.ai",
    "url": "https://agentsdr.ai"
  },
  "keywords": [
    "ghost-theme",
    "agentsdr"
  ],
  "config": {
    "posts_per_page": 12,
    "image_sizes": {
      "xxs": { "width": 30 },
      "xs": { "width": 100 },
      "s": { "width": 400 },
      "m": { "width": 750 },
      "l": { "width": 960 },
      "xl": { "width": 1140 },
      "xxl": { "width": 1600 }
    },
    "card_assets": true,
    "custom": {
      "cta_heading": { "type": "text", "default": "Own your outbound" },
      "cta_subheading": {
        "type": "text",
        "default": "AgentSDR is the open-source, self-hosted AI SDR: email, LinkedIn and WhatsApp outreach, an AI CRM and your own AI key, all running on your server."
      },
      "cta_button_text": { "type": "text", "default": "Star on GitHub" },
      "cta_button_url": { "type": "text", "default": "https://github.com/Kandid-ai/AgentSDR" },
      "cta_secondary_text": { "type": "text", "default": "Self-host it" },
      "cta_secondary_url": { "type": "text", "default": "https://github.com/Kandid-ai/AgentSDR#quick-start" },
      "site_root_url": { "type": "text", "default": "https://agentsdr.ai" },
      "rail_heading": { "type": "text", "default": "Run your own AI SDR" },
      "rail_text": {
        "type": "text",
        "default": "Open source and self-hosted. Email, LinkedIn and WhatsApp in one workspace, with your own AI key."
      },
      "rail_button_text": { "type": "text", "default": "Star on GitHub" },
      "rail_stat": { "type": "text", "default": "" },
      "rail_stat_label": { "type": "text", "default": "" }
    }
  },
  "scripts": {
    "build": "bun run build.ts"
  }
}
