{{!< default}}

<header class="hero sky hero--short error-page">
    <div class="hero__inner">
        <p class="eyebrow eyebrow--dark rise">Error {{statusCode}}</p>
        <h1 class="hero__title skytext rise" style="--rise-delay:120ms">{{message}}</h1>
        <p class="hero__lede rise" style="--rise-delay:200ms">Something went wrong on our side. Try again in a moment.</p>
        <div class="hero__actions rise" style="--rise-delay:280ms">
            <a class="btn btn--primary btn--lg" href="{{@site.url}}">Back to the blog</a>
        </div>
    </div>
</header>
