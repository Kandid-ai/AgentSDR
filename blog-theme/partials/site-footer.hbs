{{!-- Mirrors the marketing footer: brand + GitHub pill, then the same four
columns (partials/footer-cols.hbs, from catalog.ts FOOTER) and a "Built with" blurb. --}}
<footer class="foot">
    <div class="foot__inner">
        <div class="foot__top">
            <a class="foot__brand" href="{{@custom.site_root_url}}" aria-label="AgentSDR home">
                <img src="{{asset "built/images/logo.svg"}}" alt="" width="44" height="44">
                <span>
                    <span class="foot__name">AgentSDR</span>
                    <span class="foot__tag">The open-source AI SDR</span>
                </span>
            </a>
            <a class="foot__gh" href="https://github.com/Kandid-ai/AgentSDR" target="_blank" rel="noopener"><span class="foot__dot" aria-hidden="true"></span>Open source on GitHub</a>
        </div>

        <nav class="foot__cols" aria-label="Footer">
            {{> "footer-cols"}}
            <div class="foot__col foot__col--wide">
                <h3 class="foot__title">Built with</h3>
                <p class="foot__blurb">Next.js, Postgres and your own AI key. Email, LinkedIn and WhatsApp in one workspace.</p>
                {{#if @site.members_enabled}}
                    <form class="subscribe" data-members-form="subscribe">
                        <input class="subscribe__input" type="email" name="email" data-members-email placeholder="Your email" aria-label="Email address" required>
                        <button class="subscribe__btn" type="submit" aria-label="Subscribe to the blog">{{> "icons/arrow"}}</button>
                        <p class="subscribe__msg subscribe__msg--success">Thanks. Check your inbox to confirm.</p>
                        <p class="subscribe__msg subscribe__msg--error">Something went wrong. Please try again.</p>
                    </form>
                {{/if}}
            </div>
        </nav>

        <div class="foot__bar">
            <span>&copy; {{date format="YYYY"}} AgentSDR. Open source under AGPL-3.0.</span>
            <span class="foot__links">
                <a href="{{@site.url}}">Blog</a>
                <a href="{{@site.url}}rss/">RSS</a>
                <a href="{{@custom.site_root_url}}">agentsdr.ai</a>
            </span>
        </div>
    </div>
</footer>
