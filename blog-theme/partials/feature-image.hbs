{{#if feature_image}}
    <img src="{{img_url feature_image size=size}}"
         srcset="{{img_url feature_image size="m"}} 750w, {{img_url feature_image size="l"}} 960w, {{img_url feature_image size="xl"}} 1140w, {{img_url feature_image size="xxl"}} 1600w"
         sizes="(max-width: 1160px) 92vw, 1128px"
         alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
{{/if}}
