{{!-- Mirrors the marketing nav: a dark glass pill over the sky, turning into
the white pill once scrolled. Product / Solutions / Resources open the same
groups as catalog.ts NAV (partials/nav-menu.hbs). Hover and focus open them
without JS; main.js adds click-to-toggle for touch and the phone menu. --}}
<header class="nav" data-site-header>
    <div class="nav__inner">
        <div class="nav__bar">
            <a class="nav__brand" href="{{@custom.site_root_url}}" aria-label="AgentSDR home">
                <img src="{{asset "built/images/logo.svg"}}" alt="" width="32" height="32">
                <span class="nav__word">AgentSDR</span>
            </a>

            <nav class="nav__menu" id="site-menu" aria-label="Primary">
                <ul class="nav__list">
                    {{> "nav-menu"}}
                    <li class="nav__item"><a class="nav__top" href="{{@custom.site_root_url}}/compare">Compare</a></li>
                    <li class="nav__item"><a class="nav__top is-current" href="{{@site.url}}" aria-current="page">Blog</a></li>
                </ul>

                <div class="nav__menu-actions">
                    <a class="btn btn--glass nav__gh-m" href="https://github.com/Kandid-ai/AgentSDR" target="_blank" rel="noopener">GitHub</a>
                    <a class="btn btn--primary" href="{{@custom.site_root_url}}/analytics">Open the app</a>
                </div>
            </nav>

            <div class="nav__actions">
                <button class="icon-btn" type="button" data-ghost-search aria-label="Search this site">{{> "icons/search"}}</button>
                <a class="nav__gh" href="https://github.com/Kandid-ai/AgentSDR" target="_blank" rel="noopener">GitHub</a>
                <a class="btn btn--primary btn--sm nav__app" href="{{@custom.site_root_url}}/analytics">Open the app</a>
                <button class="icon-btn nav__burger" type="button" data-nav-toggle aria-label="Menu" aria-expanded="false" aria-controls="site-menu">{{> "icons/menu"}}</button>
            </div>
        </div>
    </div>
</header>
