{{#if pagination.pages}}
    {{!-- Only equality is used here: Ghost's match helper is guaranteed to
    support it, and "not exactly one page" is the whole condition. --}}
    {{#match pagination.pages 1}}{{else}}
        {{!-- Prev/Next render server-side so crawlers and no-JS visitors can walk
        the archive. main.js (built from src/main.ts) upgrades the middle into numbered pages. --}}
        <nav class="pagination" role="navigation" aria-label="Pagination"
             data-pagination data-page="{{pagination.page}}" data-pages="{{pagination.pages}}">
            {{#if pagination.prev}}
                <a class="pagination__step" href="{{page_url "prev"}}" rel="prev">Previous</a>
            {{else}}
                <span class="pagination__step is-disabled">Previous</span>
            {{/if}}

            <span class="pagination__numbers" data-pagination-numbers>Page {{pagination.page}} of {{pagination.pages}}</span>

            {{#if pagination.next}}
                <a class="pagination__step" href="{{page_url "next"}}" rel="next">Next</a>
            {{else}}
                <span class="pagination__step is-disabled">Next</span>
            {{/if}}
        </nav>
    {{/match}}
{{/if}}
