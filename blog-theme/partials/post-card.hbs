{{!-- The site's grey card: a #f7f7f8 slab, rounded media inset inside it. --}}
<a class="pcard" href="{{url}}">
    <article class="pcard__inner">
        <div class="pcard__media">
            {{#if feature_image}}
                <img src="{{img_url feature_image size="m"}}"
                     srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 750w, {{img_url feature_image size="l"}} 960w"
                     sizes="(max-width: 900px) 92vw, 420px"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                     loading="lazy" decoding="async">
            {{else}}
                <span class="media-empty" aria-hidden="true"></span>
            {{/if}}
        </div>

        <div class="pcard__body">
            <div class="pill-row">
                {{#foreach tags limit="2"}}
                    {{#match visibility "public"}}<span class="pill">{{name}}</span>{{/match}}
                {{/foreach}}
            </div>

            <h3 class="pcard__title">{{title}}</h3>
            {{#if excerpt}}<p class="pcard__excerpt">{{excerpt words="22"}}</p>{{/if}}

            <p class="pcard__meta">
                <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="D MMM YYYY"}}</time>
                <span>{{reading_time}}</span>
            </p>
        </div>
    </article>
</a>
