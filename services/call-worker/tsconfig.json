{
  // The worker's own typecheck: `npx tsc -p services/call-worker` after
  // `bun install` in this folder. The app's tsconfig leaves services/ out,
  // because CI and the app's image never install the worker's packages
  // (playwright-core, gologin) — including it failed every build from
  // 21 Oct 2026.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"]
  },
  "include": ["src/**/*.ts", "../../src/lib/calls/contract.ts", "../../src/lib/calls/stationContract.ts"]
}
